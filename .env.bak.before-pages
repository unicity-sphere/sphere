# Local dev env (gitignored). Only non-default values live here — everything
# else falls back to the code defaults (see .env.example for the full knob list).

# wallet-api backend (S4 asset custody). Unset = legacy local-custody composition.
VITE_WALLET_API_URL=https://wallet-api.staging.unicity.network

# Per-wallet SGW subscription keys (replaces the static VITE_AGGREGATOR_API_KEY,
# which is ignored while this is on). The SGW base URL is derived from the SDK
# per-network config — do NOT pin VITE_SUBSCRIPTION_API_URL unless you need the
# /sgw proxy to a local SGW stack.
VITE_SUBSCRIPTION_ENABLED=true
