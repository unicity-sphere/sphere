# Whitelist approach: exclude everything, then allow only what's needed for build
*

# Node build inputs
!package.json
!package-lock.json
!src/
!public/
!tsconfig*.json
!vite.config.ts
# Vite reads VITE_* vars from .env at build time. Without this, vars like
# VITE_PUSH_RELAY_VAPID_PUBLIC_KEY end up empty in the bundled JS.
!.env

# Entrypoint for ssl-manager stage
!deploy/entrypoint.sh

# Local sphere-sdk vendor copy (file: reference for Docker builds)
!vendor-sphere-sdk/
