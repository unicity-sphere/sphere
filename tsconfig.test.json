{
  // Extends the app config so tests resolve the SDK's subpath exports exactly
  // the way the app build does — a hand-rolled copy silently diverged and
  // reported phantom "no declaration file" errors for @unicitylabs/sphere-sdk.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "vitest/globals", "node"],
    // Tests legitimately declare fixtures they only partly use.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    // Mirrors vitest.config.ts's `alias: { "@": "/src" }` — tests use it, and
    // TypeScript has never been told about it. `paths` is NOT merged across
    // `extends` — it fully replaces the parent's — so the react/react-dom
    // entries below are SCAFFOLDING FOR THE `file:../sphere-ui` LINK ONLY
    // (see tsconfig.app.json and tests/unit/dependency-hygiene.test.ts),
    // duplicated here rather than inherited. DELETE the three react/react-dom
    // entries in the same commit that removes the link.
    "baseUrl": ".",
    "paths": {
      "@/*":         ["src/*"],
      "react":       ["./node_modules/@types/react"],
      "react-dom":   ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  // src/*.d.ts carries the ambient shim for @unicitylabs/sphere-sdk/impl/browser
  // (src/sphere-sdk-browser.d.ts); without it every test that reaches
  // SphereProvider reports a phantom "no declaration file" error.
  "include": ["tests/**/*.ts", "tests/**/*.tsx", "src/**/*.d.ts"],
  "exclude": [
    // Playwright specs need a different runner.
    "tests/e2e/**",
    // Pre-existing type errors, untouched by this branch — they predate the
    // first time tests/ was ever typechecked. Follow-up: tighten each mock.
    "tests/unit/hooks/useTransfer.test.tsx",
    "tests/unit/sdk/walletLock/lockSettings.test.ts",
    "tests/unit/sdk/walletLock/reencryptMnemonic.test.ts"
  ]
}
