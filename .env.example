# Analytics
VITE_MIXPANEL_TOKEN=

# Welcome DM
VITE_WELCOME_AGENT_NAMETAG=kbbot
VITE_WELCOME_DELAY_MS=4000

# Push relay (sphere-push-relay tenant) — both must be set together. When
# unset, push registration is disabled and calls won't ring on closed PWAs.
# See sphere-push-relay/README.md for the relay deployment.
VITE_PUSH_RELAY_NAMETAG=
VITE_PUSH_RELAY_VAPID_PUBLIC_KEY=

# Dev server HTTPS (optional)
SSL_CERT_PATH=
HMR_HOST=

# Deployment base path
BASE_PATH=/
