# UXF experimental build flag — set to "true" to enable UXF banner, green theme, and migration UI
VITE_UXF_BUILD=true

# Agent Server API URL (agentic-chatbot backend)
VITE_AGENT_API_URL=http://localhost:3000

# Unicity Aggregator URL
# Use /rpc for local dev (Vite proxy), or direct URL for remote servers
VITE_AGGREGATOR_URL=https://goggregator-test.unicity.network

# Development Server HTTPS
SSL_CERT_PATH=/home/vrogojin/certs

# HMR WebSocket host for remote development
HMR_HOST=sphere-test.dyndns.org

# Push relay (sphere-push-relay tenant). VAPID pubkey is baked into the
# build; if you rotate it, every client re-registers on next app open.
VITE_PUSH_RELAY_NAMETAG=sphere-push-relay
VITE_PUSH_RELAY_VAPID_PUBLIC_KEY=BKgP1C8lWYUsQw5iZUaxyw1eLWKaivv5Cdui2u5H0G-TQyMyyvxM3N13iJWqNebH1Sgb_Pv06JvKZxlWMsTjGwg
