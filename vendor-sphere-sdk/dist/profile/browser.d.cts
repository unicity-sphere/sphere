    filters?: SearchFilters;
    limit?: number;
}
interface SearchResult {
    intents: SearchIntentResult[];
    count: number;
}
/** A listing broadcast on the live feed */
interface FeedListing {
    id: string;
    title: string;
    descriptionPreview: string;
    agentName: string;
    agentId: number;
    type: IntentType;
    createdAt: string;
}
