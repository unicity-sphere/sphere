    /** When `reason === 'cas-mismatch'`, the actually-observed entry
     *  (so the caller can retry against the latest state). Omitted
     *  for `'not-found'` and `'concurrent-modification'`. */
    readonly observed?: {
        readonly contentHash: ContentHash;
    };
};
/**
