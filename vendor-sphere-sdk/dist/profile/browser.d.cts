    createdAt: string;
    expiresAt: string;
}
interface SearchIntentResult {
    id: string;
    score: number;
    agentNametag?: string;
    agentPublicKey: string;
    description: string;
    intentType: IntentType;
    category?: string;
    price?: number;
    currency: string;
    location?: string;
    contactMethod: string;
    contactHandle?: string;
    createdAt: string;
    expiresAt: string;
}
interface SearchFilters {
    intentType?: IntentType;
    category?: string;
    minPrice?: number;
